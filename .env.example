APP_NAME=PocketSmart AI
SECRET_KEY=change-this-in-production
DATABASE_URL=sqlite:///./data/pocketsmart.db
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
MAX_UPLOAD_MB=5

# Firebase Database (Firestore) Cloud Persistence
# Option A (For Vercel): Paste your Firebase Service Account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B (For Local Development): Relative or absolute path to your downloaded firebase service account json file
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json
# Option C: Firebase Project ID (if using Application Default Credentials)
FIREBASE_PROJECT_ID=
